# Copy to .env and adjust. Every variable the backend reads is listed here.

# SQLite database file (created on first start; migrations and sample seed run automatically).
DATABASE_URL=sqlite:agri_prototype.db

# Port the API listens on. The Vite dev server proxies /api to http://127.0.0.1:3001.
PORT=3001

# Exact origin of the frontend, for CORS.
FRONTEND_URL=http://localhost:5173

# Platform administrator, created or updated on every start. There is no default admin:
# without both values no admin account exists. 10-digit phone, 4-digit PIN.
ADMIN_PHONE=9000000009
ADMIN_PIN=4321

# PIN given to the seeded sample farmer, buyer and FPO accounts (default 1234).
DEMO_PIN=1234

# Mandi price API (keyless, data.gov.in mirror). Optional overrides.
MANDI_API_BASE_URL=https://mandi-api.onrender.com/v1
MANDI_API_STATE=Maharashtra

# Fee AgriSense takes on direct farmer–buyer deals, in percent (0–20). Shown in net realisation.
PLATFORM_FEE_PERCENT=0

# Log level for tracing.
RUST_LOG=agri_backend=debug,info

# Not needed: the Mandi API has no key, and login tokens are random values stored
# (hashed) in the sessions table, so there is no signing secret.

# Buyer verification
# 32-byte key for AES-256-GCM encryption of documents and bank account numbers
# (64 hex chars or base64). Generate: openssl rand -hex 32. Without it, document upload is off.
DOC_ENCRYPTION_KEY=
# Max order value for ID Verified (Level 1) buyers, in rupees.
BASIC_BUYER_ORDER_LIMIT=200000
# Phone OTP: "fixed" sends no SMS and the code is always OTP_FIXED_CODE (test mode).
OTP_MODE=fixed
OTP_FIXED_CODE=123456

# AgriBot AI. Without a key AgriBot uses its built-in answers.
# Free: Google Gemini API key from https://aistudio.google.com/apikey (free daily limit).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Read aloud in Hindi when the browser has no Hindi voice (free tier).
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_VOICE=Kore
# Optional, paid: Claude. Used only if GEMINI_API_KEY is empty (or AGRIBOT_PROVIDER=claude).
ANTHROPIC_API_KEY=
AGRIBOT_MODEL=claude-haiku-5-5
# Force a provider: gemini | claude (default: Gemini if its key is set, else Claude).
AGRIBOT_PROVIDER=
# Questions per user per hour.
AGRIBOT_HOURLY_LIMIT=30
